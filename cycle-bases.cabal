cabal-version:       2.2
name:                cycle-bases
version:             0.1.0.0
synopsis:            Minimal cycle bases of graphs over prime fields
homepage:            https://github.com/ckaipf/cycle-bases#readme
license:             BSD-3-Clause
author:              Simon Johanning, Camill Kaipf
category:            Math
build-type:          Simple
extra-source-files:  README.md
                     test/example1
                     test/example2
                     test/example3

library
  hs-source-dirs:      src
  exposed-modules:     Gauss
                     , EdgeShort
                     , Graph
                     , Horton
                     , DePina
                     , FloydWarshall
                     , TH
  build-depends:       base >= 4.7 && < 5
                     , vector
                     , finite-field >= 0.10
                     , containers >= 0.5
                     , template-haskell >= 2.11
                     , primes
  default-language:    Haskell2010

test-suite cycle-bases-test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Spec.hs
  build-depends:       base
                     , vector
                     , finite-field >= 0.10
                     , cycle-bases
                     , template-haskell >= 2.11
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
  default-language:    Haskell2010

source-repository head
  type:     git
  location: https://github.com/ckaipf/cycle-bases
